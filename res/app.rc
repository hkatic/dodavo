// UTF-8, for the author's name and the copyright sign.
#pragma code_page(65001)

// VER_MAJOR, VER_MINOR, VER_PATCH, VER_STR, APP_AUTHOR, APP_COPYRIGHT and
// APP_WEBSITE, from Cargo.toml (written by build.rs to OUT_DIR).
#include "app-info.h"

1 ICON "app.ico"
// res/app.manifest with the version filled in (build.rs, in OUT_DIR).
1 24 "Dodavo.exe.manifest"

1 VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", APP_AUTHOR
      VALUE "FileDescription", "Dodavo"
      VALUE "ProductName", "Dodavo"
      VALUE "FileVersion", VER_STR
      VALUE "ProductVersion", VER_STR
      VALUE "OriginalFilename", "Dodavo.exe"
      VALUE "LegalCopyright", APP_COPYRIGHT
      // Not shown by Windows; Setup takes its web addresses from here.
      VALUE "Website", APP_WEBSITE
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
